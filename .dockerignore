# Docker context is the emulator repo root (POC Dockerfile COPY . .).
# Keep all Go modules/sources, api-spec, pkg/*, cmd/*, and
# poc/2fa-vault/web (including the committed same-origin vendor tree).

# VCS / editor
.git
.github
.idea
.vscode
.claude
*.swp
*.swo
*~
.DS_Store
*.orig
*.rej

# Local SQLite and other DBs (never bake a live ledger)
*.sqlite*
*.db*

# cmd/demo harness keys and any other local hex key material
*.hex

# Browser-captured WebAuthn/Chrome evidence is local and must not enter the
# Docker daemon or build cache through the broad authorizer build context.
poc/2fa-vault/testdata/webauthn_get.json
poc/2fa-vault/testdata/chrome-*
poc/2fa-vault/testdata/*.capture*

# Deployment secrets and local environment files. Keep all real secret files
# outside the repository as well; these patterns are defense in depth against
# accidentally adding one to a Docker build context.
.env
.env.*
!.env.example
!.env.*.example
*.key
!*.key.example
*.pem
!*.pem.example
*.p12
*.pfx
*.secret
!*.secret.example
*.secrets
!*.secrets.example
provider-key
provider_key
enrollment-token
enrollment_token
secrets/
**/secrets/

# Local data directories written by demo/provider outside the image
/data
data/
**/data/

# Coverage, test binaries, profiles
*.out
*.cov
*.cover
coverage.html
*.coverprofile
*.test
*.prof
*.pprof

# Build / scratch output
bin/
build/
dist/
out/
tmp/
temp/
*.exe
*.o
*.a

# Local JS tool output (committed web/vendor stays; do not add a vendor/ rule)
node_modules/
.bun/
